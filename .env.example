# Copy to .env.local for local work. On GitHub, set these as repository variables.
# Without them the page still builds: Analytics stays off and the form reports an error.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Form service endpoint. It must take a JSON POST (with CORS) and answer 2xx with a JSON body,
# e.g. https://formspree.io/f/xxxxxxxx
VITE_FORM_ENDPOINT=

# The public address, e.g. https://your-name.github.io/virtual-shop/ (for the canonical and share tags)
VITE_SITE_URL=
